---
import { Icon } from 'astro-icon/components';

const certifications = [
  {
    title: "Security, Compliance and Identity Fundamentals",
    code: "SC-900",
    issuer: "Microsoft",
    date: "07/2026",
    icon: "logos:microsoft-icon"
  },
  {
    title: "AWS Certified Cloud Practitioner",
    code: "CLF-C02",
    issuer: "Amazon Web Services",
    date: "05/2026",
    icon: "logos:aws"
  },
  {
    title: "Azure Fundamentals",
    code: "AZ-900",
    issuer: "Microsoft",
    date: "04/2026",
    icon: "logos:microsoft-azure"
  },
  {
    title: "IT Specialist - Python",
    code: "Certiport",
    issuer: "Pearson VUE",
    date: "03/2025",
    icon: "logos:python"
  }
];
---

<section id="certificazioni" class="py-20 bg-white dark:bg-slate-900 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl transition-colors">Certificazioni</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 transition-colors">Le mie qualifiche professionali riconosciute dai principali vendor.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {certifications.map(cert => (
        <div class="group flex flex-col rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-6 hover:border-blue-300 dark:hover:border-slate-500 hover:shadow-lg transition-all duration-300 relative overflow-hidden">
          <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity transform group-hover:scale-110 group-hover:-rotate-12">
             <Icon name={cert.icon} class="w-24 h-24" />
          </div>
          
          <div class="flex items-center gap-4 mb-4 relative z-10">
            <div class="flex-shrink-0 w-12 h-12 bg-slate-50 dark:bg-slate-700 rounded-lg flex items-center justify-center ring-1 ring-inset ring-slate-200 dark:ring-slate-600 transition-colors">
              <Icon name={cert.icon} class="w-7 h-7" />
            </div>
            <div>
              <div class="text-sm font-semibold text-blue-600 dark:text-blue-400 transition-colors">{cert.code}</div>
              <div class="text-xs font-medium text-slate-500 dark:text-slate-400 transition-colors">{cert.date}</div>
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 dark:text-white leading-tight mb-1 relative z-10 transition-colors">{cert.title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 relative z-10 transition-colors">{cert.issuer}</p>
        </div>
      ))}
    </div>
  </div>
</section>

