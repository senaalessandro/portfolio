---

<section id="certificazioni" class="py-20 bg-white dark:bg-slate-900 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl transition-colors">Certificazioni</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 transition-colors">Le mie qualifiche professionali e badge di specializzazione.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {certifications.map(cert => (
        <a 
          href={cert.verifyUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group flex flex-col rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-300 shadow-md dark:border-slate-700 p-8 hover:-translate-y-1 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-xl transition-all duration-300 relative overflow-hidden min-h-[320px]"
        >
          <!-- Sfondo animato -->
          <div class="absolute top-0 right-0 p-4 opacity-30 dark:opacity-20 group-hover:opacity-40 dark:group-hover:opacity-30 transition-all duration-500 transform group-hover:scale-110 group-hover:-rotate-12 pointer-events-none">
             <img src={cert.bgIconLight} alt="" aria-hidden="true" class="w-32 h-32 object-contain dark:hidden" />
             <img src={cert.bgIconDark} alt="" aria-hidden="true" class="w-32 h-32 object-contain hidden dark:block" />
          </div>
          
          <!-- Top: Badge -->
          <div class="mb-6 relative z-10 h-32 flex items-center justify-start">
            <img src={cert.badgeSrc} alt={`Badge ${cert.title}`} class="w-32 h-32 object-contain drop-shadow-sm group-hover:drop-shadow-md transition-all duration-300" />
          </div>
          
          <!-- Middle: Titolo -->
          <div class="flex-grow relative z-10">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-tight mb-2 transition-colors">{cert.title}</h3>
          </div>
          
          <!-- Bottom: Dettagli -->
          <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between relative z-10 transition-colors">
            <div class="flex flex-col">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 transition-colors">{cert.vendor}</span>
              <span class="text-sm font-medium text-slate-600 dark:text-slate-300 transition-colors">{cert.date}</span>
            </div>
            
            <div class="flex-shrink-0 w-12 h-12 bg-slate-50 dark:bg-slate-700 rounded-lg flex items-center justify-center ring-1 ring-inset ring-slate-200 dark:ring-slate-600 transition-colors">
              <img src={cert.logoLight} alt={cert.vendor} class="w-7 h-7 object-contain dark:hidden" />
              <img src={cert.logoDark} alt={cert.vendor} class="w-7 h-7 object-contain hidden dark:block" />
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

