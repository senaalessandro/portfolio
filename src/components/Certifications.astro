---
const certifications = [
  {
    title: "Microsoft Security, Compliance, and Identity Fundamentals (SC-900)",
    vendor: "Microsoft",
    date: "07/2026",
    verifyUrl: "https://learn.microsoft.com/it-it/users/senaalessandro/credentials/AC85492B6DEA0869",
    badgeSrc: "/badges/sc-900.png",
    bgIconLight: "/logos/azure.png",
    bgIconDark: "/logos/azure.png",
    logoLight: "/logos/microsoft.png",
    logoDark: "/logos/microsoft.png"
  },
  {
    title: "AWS Certified Cloud Practitioner (CLF-C02)",
    vendor: "Amazon Web Services",
    date: "05/2026 - 05/2029",
    verifyUrl: "https://www.credly.com/badges/be4e8c32-7a0d-4b54-b329-42af81a9ff83/public_url",
    badgeSrc: "/badges/clf-c02.png",
    bgIconLight: "/logos/aws-dark.png",
    bgIconDark: "/logos/aws-white.png",
    logoLight: "/logos/aws-dark.png",
    logoDark: "/logos/aws-white.png"
  },
  {
    title: "Microsoft Azure Fundamentals (AZ-900)",
    vendor: "Microsoft",
    date: "04/2026",
    verifyUrl: "https://learn.microsoft.com/it-it/users/senaalessandro/credentials/b8dbc5a95c8801f7",
    badgeSrc: "/badges/az-900.png",
    bgIconLight: "/logos/azure.png",
    bgIconDark: "/logos/azure.png",
    logoLight: "/logos/microsoft.png",
    logoDark: "/logos/microsoft.png"
  },
  {
    title: "AWS Academy Graduate - Cloud Foundations - Training Badge",
    vendor: "Amazon Web Services",
    date: "04/2026",
    verifyUrl: "https://www.credly.com/badges/0cfe4c8d-71a8-4a9b-aee9-94e39b8c5c44/public_url",
    badgeSrc: "/badges/aws-academy.png",
    bgIconLight: "/logos/aws-dark.png",
    bgIconDark: "/logos/aws-white.png",
    logoLight: "/logos/aws-dark.png",
    logoDark: "/logos/aws-white.png"
  },
  {
    title: "Microsoft Introduction to Datacenters - Course Graduate",
    vendor: "Microsoft",
    date: "03/2026",
    verifyUrl: "https://www.credly.com/badges/d83af9ea-dc36-497a-ae24-d66ec411558c/public_url",
    badgeSrc: "/badges/ms-datacenters.png",
    bgIconLight: "/logos/microsoft.png",
    bgIconDark: "/logos/microsoft.png",
    logoLight: "/logos/microsoft.png",
    logoDark: "/logos/microsoft.png"
  },
  {
    title: "IT Specialist - Python",
    vendor: "Certiport (Pearson VUE)",
    date: "03/2025",
    verifyUrl: "https://www.credly.com/badges/19246cbc-2fc1-4ba1-8c4f-f1e92ca78deb/public_url",
    badgeSrc: "/badges/python-specialist.png",
    bgIconLight: "/logos/python.png",
    bgIconDark: "/logos/python.png",
    logoLight: "/logos/pearson-white.png",
    logoDark: "/logos/pearson-dark.png"
  }
];
const revealDelays = ['', 'delay-100', 'delay-200'];
---

<section id="certificazioni" class="relative isolate py-20">
  <!-- Ambient Glow -->
  <div aria-hidden="true" class="pointer-events-none select-none absolute inset-0 -z-10 flex items-end justify-center md:justify-end">
    <div class="h-[380px] w-[600px] translate-x-12 md:translate-x-16 md:mr-[5%] mb-8 rounded-full bg-gradient-to-tl from-blue-300/10 via-indigo-200/8 to-transparent dark:from-blue-700/15 dark:via-indigo-500/12 dark:to-transparent blur-3xl"></div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl transition-colors">Certificazioni</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 transition-colors">Le mie qualifiche professionali e badge di specializzazione.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 auto-rows-fr">
      {certifications.map((cert, index) => (
        <div class={`reveal ${revealDelays[index % 3]} flex`.trim()}>
        <a 
          href={cert.verifyUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group relative overflow-hidden flex flex-col w-full rounded-2xl bg-white/75 dark:bg-slate-800/55 backdrop-blur-sm border border-slate-300/80 dark:border-slate-700/80 shadow-sm p-8 hover:-translate-y-1 hover:bg-white/90 dark:hover:bg-slate-800/75 hover:border-blue-400/60 dark:hover:border-cyan-400/50 hover:shadow-lg hover:shadow-blue-500/10 dark:hover:shadow-cyan-500/15 transition-all duration-300 min-h-[320px]"
        >
          <!-- Top Highlight -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-400/20 dark:via-blue-400/35 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300"
          ></div>

          <!-- Internal Hover Glow -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(59,130,246,0.06),transparent_65%)] dark:bg-[radial-gradient(circle_at_50%_0%,rgba(56,189,248,0.12),transparent_65%)] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          ></div>
          <!-- Sfondo animato -->
          <div class="absolute top-0 right-0 p-4 opacity-15 dark:opacity-5 group-hover:opacity-25 dark:group-hover:opacity-10 transition-all duration-500 transform group-hover:scale-110 group-hover:rotate-12 pointer-events-none">
             <img src={cert.bgIconLight} alt="" aria-hidden="true" class="w-24 h-24 object-contain dark:hidden" />
             <img src={cert.bgIconDark} alt="" aria-hidden="true" class="w-24 h-24 object-contain hidden dark:block" />
          </div>
          
          <!-- Top: Badge -->
          <div class="mb-6 relative z-10 h-36 flex items-center justify-start">
            <img src={cert.badgeSrc} alt={`Badge ${cert.title}`} class="w-36 h-36 object-contain drop-shadow-sm group-hover:drop-shadow-md transition-all duration-300" />
          </div>
          
          <!-- Middle: Titolo -->
          <div class="flex-grow relative z-10">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-tight mb-2 transition-colors">{cert.title}</h3>
          </div>
          
          <!-- Bottom: Dettagli -->
          <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between relative z-10 transition-colors">
            <div class="flex flex-col">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 transition-colors">{cert.vendor}</span>
              <span class="text-sm font-medium text-slate-600 dark:text-slate-300 transition-colors">{cert.date}</span>
            </div>
            
            <div class="flex-shrink-0 w-12 h-12 bg-slate-50 dark:bg-slate-700 rounded-lg flex items-center justify-center ring-1 ring-inset ring-slate-200 dark:ring-slate-600 transition-colors">
              <img src={cert.logoLight} alt={cert.vendor} class="w-7 h-7 object-contain dark:hidden" />
              <img src={cert.logoDark} alt={cert.vendor} class="w-7 h-7 object-contain hidden dark:block" />
            </div>
          </div>
        </a>
        </div>
      ))}
    </div>
  </div>
</section>

