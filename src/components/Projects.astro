---
import ProjectCard from './ProjectCard.astro';
import { Icon } from 'astro-icon/components';
import { projects } from '../data/projects';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const localizedProjects = projects.map((project) => ({
  ...project,
  title: project.title[lang],
  description: project.description[lang],
}));

const featuredProjects = localizedProjects.filter((project) => project.featured);
const otherProjects = localizedProjects.filter((project) => !project.featured);
const showMoreLabel = `${t('projects.showMorePrefix')} (+${otherProjects.length})`;
const showLessLabel = t('projects.showLess');
---

<section id="progetti" class="relative isolate py-20">
  <!-- Ambient Glow -->
  <div aria-hidden="true" class="pointer-events-none select-none absolute inset-0 -z-10 flex items-center justify-center md:justify-end">
    <div class="h-[360px] w-[580px] translate-x-12 md:translate-x-16 md:mr-[5%] rounded-full bg-gradient-to-br from-sky-300/10 via-cyan-200/5 to-transparent dark:from-blue-600/15 dark:via-cyan-500/10 dark:to-transparent blur-3xl"></div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12 reveal">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl transition-colors">{t('projects.title')}</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 max-w-2xl transition-colors">{t('projects.subtitle')}</p>
    </div>

    <!-- Griglia Progetti Principali -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch reveal delay-100">
      {featuredProjects.map(project => (
        <ProjectCard {...project} lang={lang} />
      ))}
    </div>

    {otherProjects.length > 0 && (
      <>
        <!-- Sezione Espandibile Altri Progetti -->
        <div
          id="extra-projects-wrapper"
          aria-hidden="true"
          class="grid grid-rows-[0fr] opacity-0 pointer-events-none transition-[grid-template-rows,opacity] duration-500 ease-out"
        >
          <div class="overflow-hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch pt-6 pb-4 px-1 -mx-1">
              {otherProjects.map(project => (
                <ProjectCard {...project} lang={lang} />
              ))}
            </div>
          </div>
        </div>

        <!-- Pulsante Espandi / Comprimi -->
        <div class="mt-10 flex justify-center reveal delay-200">
          <button
            id="toggle-projects-btn"
            type="button"
            aria-expanded="false"
            aria-controls="extra-projects-wrapper"
            data-more-label={showMoreLabel}
            data-less-label={showLessLabel}
            class="group inline-flex items-center gap-2.5 rounded-full bg-white/75 dark:bg-slate-800/60 backdrop-blur-sm border border-slate-300/80 dark:border-slate-700/80 px-6 py-3 text-sm font-semibold text-slate-800 dark:text-slate-100 shadow-sm hover:bg-blue-500/15 dark:hover:bg-blue-500/15 hover:border-blue-400/60 dark:hover:border-cyan-400/60 hover:text-blue-700 dark:hover:text-cyan-300 hover:shadow-[0_0_20px_-2px_rgba(59,130,246,0.28)] dark:hover:shadow-[0_0_22px_-2px_rgba(56,189,248,0.28)] hover:-translate-y-0.5 hover:scale-[1.03] active:scale-100 transition-all duration-300 cursor-pointer"
          >
            <span id="toggle-projects-label">{showMoreLabel}</span>
            <Icon
              id="toggle-projects-icon"
              name="ph:caret-down-bold"
              class="w-4 h-4 transition-transform duration-300"
            />
          </button>
        </div>
      </>
    )}
  </div>
</section>

<script>
  function initProjectsToggle() {
    const toggleBtn = document.getElementById('toggle-projects-btn');
    const wrapper = document.getElementById('extra-projects-wrapper');
    const label = document.getElementById('toggle-projects-label');
    const icon = document.getElementById('toggle-projects-icon');

    if (!toggleBtn || !wrapper || !label || !icon) return;
    if (toggleBtn.dataset.bound === 'true') return;
    toggleBtn.dataset.bound = 'true';

    wrapper.inert = true;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;

      toggleBtn.setAttribute('aria-expanded', String(nextExpanded));
      wrapper.setAttribute('aria-hidden', String(!nextExpanded));
      wrapper.inert = !nextExpanded;

      wrapper.classList.toggle('grid-rows-[1fr]', nextExpanded);
      wrapper.classList.toggle('grid-rows-[0fr]', !nextExpanded);
      wrapper.classList.toggle('opacity-100', nextExpanded);
      wrapper.classList.toggle('opacity-0', !nextExpanded);
      wrapper.classList.toggle('pointer-events-none', !nextExpanded);

      icon.classList.toggle('rotate-180', nextExpanded);
      label.textContent = nextExpanded
        ? (toggleBtn.dataset.lessLabel || 'Mostra meno')
        : (toggleBtn.dataset.moreLabel || 'Mostra altri progetti');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectsToggle, { once: true });
  } else {
    initProjectsToggle();
  }

  document.addEventListener('astro:page-load', initProjectsToggle);
</script>
