---
import ProjectCard from './ProjectCard.astro';
import { Icon } from 'astro-icon/components';

const projects = [
  {
    title: "Homelab Proxmox & PBS",
    description: "Progettazione e messa in produzione di un'infrastruttura Homelab avanzata basata su Proxmox VE e PBS. Architettura focalizzata su sicurezza (pfSense, WireGuard), performance (Docker in LXC) e affidabilità con storage ibrido ZFS e Disaster Recovery automatizzato.",
    slug: "homelab-pve",
    status: "In corso" as const,
    featured: true,
    techs: [
      { icon: "/logos/proxmox.png" },
      { icon: "/logos/pfsense.png" },
      { icon: "/logos/docker.png" },
      { icon: "/logos/npm.png" },
      { icon: "/logos/immich.png" }
    ]
  },
  {
    title: "Cluster Hyper-V & DR",
    description: "Progettazione e implementazione di un cluster Microsoft Hyper-V in alta affidabilità (HA). Architettura completa con Windows Server 2022, Active Directory, SAN iSCSI centralizzata, networking SDN e Disaster Recovery basato su Hyper-V Replica.",
    slug: "cluster-hyperv",
    status: "Completato" as const,
    featured: true,
    techs: [
      { icon: "/logos/win10.png" }, 
      { icon: "/logos/hyperv.png" }
    ]
  },
  {
    title: "Nextcloud su Azure",
    description: "Progettazione e deploy di un'infrastruttura Cloud su Microsoft Azure per l'hosting di Nextcloud. Architettura disaccoppiata (VM Debian, DB PostgreSQL in VNet Peering, Storage GZRS), sicurezza perimetrale (Nginx Proxy Manager, NSG) e caching ottimizzato (Redis/APCu).",
    slug: "nextcloud-azure",
    status: "Completato" as const,
    featured: true,
    techs: [
      { icon: "/logos/azure.png" },
      { icon: "/logos/nextcloud.png" },
      { icon: "/logos/postgresql.png" }
    ]
  },
  {
    title: "Active Directory & HA",
    description: "Progettazione e implementazione di un'infrastruttura di dominio Microsoft. Configurazione di Active Directory in alta affidabilità (doppio Domain Controller), DHCP Failover, File Server con deduplica dati e automazione tramite Group Policy (GPO).",
    slug: "ad-winsrv",
    status: "Completato" as const,
    featured: false,
    techs: [
      { icon: "/logos/win10.png" },  
      { icon: "/logos/active-directory.png" },
      { icon: "/logos/dns.png" }
    ]
  },
  {
    title: "Machine Learning con Python",
    description: "Analisi dati IMDb su Jupyter Notebook, pulizia dati con Numpy/Pandas, sviluppo e test di algoritmi predittivi.",
    slug: "ml-python",
    status: "Completato" as const,
    featured: false,
    techs: [
      { icon: "/logos/python.png" },
      { icon: "/logos/anaconda.png" },
      { icon: "/logos/jupyter.png" }
    ]
  },
  {
    title: "Backup centralizzato con UrBackup",
    description: "Gestione backup schedulati per ambienti Windows e Linux con limitazione della banda massima tramite UrBackup.",
    slug: "urbackup",
    status: "Sospeso" as const,
    featured: false,
    techs: [
      { icon: "/logos/urbackup.png" },
      { icon: "/logos/win11.png" },
      { icon: "/logos/linux.png" }
    ]
  }
];

const featuredProjects = projects.filter((project) => project.featured);
const otherProjects = projects.filter((project) => !project.featured);
---

<section id="progetti" class="relative isolate py-20">
  <!-- Ambient Glow -->
  <div aria-hidden="true" class="pointer-events-none select-none absolute inset-0 -z-10 flex items-center justify-center md:justify-end">
    <div class="h-[360px] w-[580px] translate-x-12 md:translate-x-16 md:mr-[5%] rounded-full bg-gradient-to-br from-sky-300/10 via-cyan-200/5 to-transparent dark:from-blue-600/15 dark:via-cyan-500/10 dark:to-transparent blur-3xl"></div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12 reveal">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl transition-colors">Progetti in Evidenza</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 max-w-2xl transition-colors">Una selezione dei laboratori pratici e delle infrastrutture che ho progettato e configurato.</p>
    </div>

    <!-- Griglia Progetti Principali -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch reveal delay-100">
      {featuredProjects.map(project => (
        <ProjectCard {...project} />
      ))}
    </div>

    {otherProjects.length > 0 && (
      <>
        <!-- Sezione Espandibile Altri Progetti -->
        <div
          id="extra-projects-wrapper"
          aria-hidden="true"
          class="grid grid-rows-[0fr] opacity-0 pointer-events-none transition-[grid-template-rows,opacity] duration-500 ease-out"
        >
          <div class="overflow-hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch pt-6 pb-4 px-1 -mx-1">
              {otherProjects.map(project => (
                <ProjectCard {...project} />
              ))}
            </div>
          </div>
        </div>

        <!-- Pulsante Espandi / Comprimi -->
        <div class="mt-10 flex justify-center reveal delay-200">
          <button
            id="toggle-projects-btn"
            type="button"
            aria-expanded="false"
            aria-controls="extra-projects-wrapper"
            data-more-label={`Mostra altri progetti (+${otherProjects.length})`}
            data-less-label="Mostra meno"
            class="group inline-flex items-center gap-2.5 rounded-full bg-white/75 dark:bg-slate-800/60 backdrop-blur-sm border border-slate-300/80 dark:border-slate-700/80 px-6 py-3 text-sm font-semibold text-slate-800 dark:text-slate-100 shadow-sm hover:bg-blue-500/15 dark:hover:bg-blue-500/15 hover:border-blue-400/60 dark:hover:border-cyan-400/60 hover:text-blue-700 dark:hover:text-cyan-300 hover:shadow-[0_0_20px_-2px_rgba(59,130,246,0.28)] dark:hover:shadow-[0_0_22px_-2px_rgba(56,189,248,0.28)] hover:-translate-y-0.5 hover:scale-[1.03] active:scale-100 transition-all duration-300 cursor-pointer"
          >
            <span id="toggle-projects-label">Mostra altri progetti (+{otherProjects.length})</span>
            <Icon
              id="toggle-projects-icon"
              name="ph:caret-down-bold"
              class="w-4 h-4 transition-transform duration-300"
            />
          </button>
        </div>
      </>
    )}
  </div>
</section>

<script>
  function initProjectsToggle() {
    const toggleBtn = document.getElementById('toggle-projects-btn');
    const wrapper = document.getElementById('extra-projects-wrapper');
    const label = document.getElementById('toggle-projects-label');
    const icon = document.getElementById('toggle-projects-icon');

    if (!toggleBtn || !wrapper || !label || !icon) return;
    if (toggleBtn.dataset.bound === 'true') return;
    toggleBtn.dataset.bound = 'true';

    wrapper.inert = true;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;

      toggleBtn.setAttribute('aria-expanded', String(nextExpanded));
      wrapper.setAttribute('aria-hidden', String(!nextExpanded));
      wrapper.inert = !nextExpanded;

      wrapper.classList.toggle('grid-rows-[1fr]', nextExpanded);
      wrapper.classList.toggle('grid-rows-[0fr]', !nextExpanded);
      wrapper.classList.toggle('opacity-100', nextExpanded);
      wrapper.classList.toggle('opacity-0', !nextExpanded);
      wrapper.classList.toggle('pointer-events-none', !nextExpanded);

      icon.classList.toggle('rotate-180', nextExpanded);
      label.textContent = nextExpanded
        ? (toggleBtn.dataset.lessLabel || 'Mostra meno')
        : (toggleBtn.dataset.moreLabel || 'Mostra altri progetti');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectsToggle, { once: true });
  } else {
    initProjectsToggle();
  }

  document.addEventListener('astro:page-load', initProjectsToggle);
</script>
