---
import ProjectCard from './ProjectCard.astro';
import { Icon } from 'astro-icon/components';

const projects = [
  {
    title: "Homelab Proxmox & PBS",
    description: "Progettazione e messa in produzione di un'infrastruttura Homelab avanzata basata su Proxmox VE e PBS. Architettura focalizzata su sicurezza (pfSense, WireGuard), performance (Docker in LXC) e affidabilità con storage ibrido ZFS e Disaster Recovery automatizzato.",
    slug: "homelab-pve",
    status: "In corso",
    techs: [
      { icon: "/logos/proxmox.png" },
      { icon: "/logos/pfsense.png" },
      { icon: "/logos/docker.png" },
      { icon: "/logos/npm.png" },
      { icon: "/logos/immich.png" }
    ]
  },
  {
    title: "Nextcloud su Azure",
    description: "Progettazione e deploy di un'infrastruttura Cloud Enterprise su Microsoft Azure per l'hosting di Nextcloud. Architettura disaccoppiata (VM Debian, DB PostgreSQL in VNet Peering, Storage GZRS), sicurezza perimetrale (Nginx Proxy Manager, NSG) e caching ottimizzato (Redis/APCu).",
    slug: "nextcloud-azure",
    status: "Completato",
    techs: [
      { icon: "/logos/azure.png" },
      { icon: "/logos/nextcloud.png" },
      { icon: "/logos/postgresql.png" }
    ]
  },
  {
    title: "Active Directory & HA",
    description: "Progettazione e implementazione di un'infrastruttura di dominio Microsoft in ambiente misto (WS 2019/2022). Configurazione di Active Directory in alta affidabilità (doppio Domain Controller), DHCP Failover, File Server con deduplica dati e automazione tramite Group Policy (GPO).",
    slug: "ad-winsrv",
    status: "Completato",
    techs: [
      { icon: "/logos/win10.png" },  
      { icon: "/logos/active-directory.png" },
      { icon: "/logos/dns.png" }
    ]
  },
  {
    title: "Cluster Hyper-V",
    description: "Progettazione di un cluster Hyper-V in ambiente Nested Virtualization. Automazione del provisioning tramite PowerShell, configurazione di Active Directory e implementazione di logiche di Alta Affidabilità aziendale (VM Replica e Live Migration con delega Kerberos).",
    slug: "cluster-hyperv",
    status: "Completato",
    techs: [
      { icon: "/logos/win10.png" }, 
      { icon: "/logos/hyperv.png" },
      { icon: "/logos/powershell.png" }
    ]
  },
  {
    title: "Machine Learning con Python",
    description: "Analisi dati IMDb su Jupyter Notebook, pulizia dati con Numpy/Pandas, sviluppo e test di algoritmi predittivi.",
    slug: "ml-python",
    status: "Completato",
    techs: [
      { icon: "/logos/python.png" },
      { icon: "/logos/anaconda.png" },
      { icon: "/logos/jupyter.png" }
    ]
  },
  {
    title: "Backup centralizzato con UrBackup",
    description: "Gestione backup schedulati per ambienti Windows e Linux con limitazione della banda massima tramite UrBackup.",
    slug: "urbackup",
    status: "Sospeso",
    techs: [
      { icon: "/logos/urbackup.png" },
      { icon: "/logos/win11.png" },
      { icon: "/logos/linux.png" }
    ]
  }
];
---

<section id="progetti" class="py-20 bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex items-end justify-between">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl transition-colors">Progetti in Evidenza</h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 max-w-2xl transition-colors">Una selezione dei laboratori pratici e delle infrastrutture che ho progettato e configurato.</p>
      </div>
      
      <!-- Optional navigation buttons for desktop -->
      <div class="hidden md:flex gap-2">
        <button id="scroll-left" class="p-2 rounded-full border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400 transition-colors" aria-label="Scorri a sinistra">
          <Icon name="ph:caret-left-bold" class="w-5 h-5" />
        </button>
        <button id="scroll-right" class="p-2 rounded-full border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400 transition-colors" aria-label="Scorri a destra">
          <Icon name="ph:caret-right-bold" class="w-5 h-5" />
        </button>
      </div>
    </div>
    
    <div class="relative">
      <div 
        id="carousel" 
        class="flex items-stretch gap-6 overflow-x-auto snap-x snap-mandatory pb-8 pt-2 scrollbar-hide"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {projects.map(project => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Simple vanilla JS for carousel buttons
  const carousel = document.getElementById('carousel');
  const scrollLeftBtn = document.getElementById('scroll-left');
  const scrollRightBtn = document.getElementById('scroll-right');

  if (carousel && scrollLeftBtn && scrollRightBtn) {
    const scrollAmount = 400; // Adjust based on card width + gap

    scrollLeftBtn.addEventListener('click', () => {
      if (carousel.scrollLeft <= 0) {
        carousel.scrollTo({ left: carousel.scrollWidth, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      }
    });

    scrollRightBtn.addEventListener('click', () => {
      if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 1) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
