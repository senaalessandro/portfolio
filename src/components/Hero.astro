---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative isolate pt-12 pb-24 md:pt-16 md:pb-32" id="home">
  <!-- Ambient Glow -->
  <div aria-hidden="true" class="pointer-events-none select-none absolute inset-x-0 -top-24 -z-10 flex justify-center">
    <div class="h-[340px] w-[580px] -translate-x-16 rounded-full bg-gradient-to-tr from-blue-500/15 via-cyan-400/10 to-transparent dark:from-blue-600/20 dark:via-cyan-500/15 dark:to-transparent blur-3xl"></div>
  </div>
  <div aria-hidden="true" class="pointer-events-none select-none absolute top-16 right-[10%] -z-10 hidden md:block">
    <div class="h-[260px] w-[260px] rounded-full bg-cyan-400/12 dark:bg-cyan-500/10 blur-3xl"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-8">
      
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white transition-colors">
        Alessandro Sena
        <span class="block mt-2">
          <span class="inline-block pb-1 bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-600 dark:from-blue-400 dark:via-sky-400 dark:to-cyan-300 bg-clip-text text-transparent">
            {t('hero.subtitle')}
          </span>
        </span>
      </h1>
      
      <div class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed transition-colors">
        <p class="mb-5">
          {t('hero.roleLine')}
        </p>
        <p class="mb-5">
          {t('hero.bio1Prefix')}<strong class="font-semibold text-slate-900 dark:text-white transition-colors">{t('hero.bio1Strong')}</strong>{t('hero.bio1Suffix')}
        </p>
        <p class="mb-5">
          {t('hero.bio2')}
        </p>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a href="#progetti" class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-blue-600 to-blue-500 border-t border-white/20 px-6 py-3 text-base font-semibold text-white shadow-[0_4px_20px_-2px_rgba(37,99,235,0.35)] dark:shadow-[0_4px_24px_-2px_rgba(56,189,248,0.3)] hover:scale-105 active:scale-100 hover:brightness-110 hover:shadow-[0_0_24px_rgba(59,130,246,0.5)] dark:hover:shadow-[0_0_26px_rgba(56,189,248,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 transition-all duration-300">
          {t('hero.ctaProjects')}
          <Icon name="ph:arrow-right-bold" class="ml-2 h-5 w-5" />
        </a>
        <a href="#contatti" class="inline-flex items-center justify-center rounded-lg bg-white/80 dark:bg-slate-800/60 backdrop-blur-md border border-slate-300/90 dark:border-slate-700/80 px-6 py-3 text-base font-semibold text-slate-800 dark:text-slate-100 shadow-sm hover:bg-blue-500/15 dark:hover:bg-blue-500/15 hover:border-blue-400/60 dark:hover:border-cyan-400/60 hover:text-blue-700 dark:hover:text-cyan-300 hover:shadow-[0_0_20px_-2px_rgba(59,130,246,0.28)] dark:hover:shadow-[0_0_22px_-2px_rgba(56,189,248,0.28)] hover:-translate-y-0.5 hover:scale-[1.03] active:scale-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 transition-all duration-300">
          {t('hero.ctaContact')}
        </a>
      </div>
    </div>
  </div>
</section>
