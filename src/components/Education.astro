---
const educationData = [
  {
    period: "10/2025 - Attuale",
    role: "ITS Network and Cloud Specialist",
    institution: "ITS Angelo Rizzoli, Milano",
    logo: "/logos/itsar.png",
    description: "Percorso di alta specializzazione tecnica (5 EQF), focalizzato su Networking, Cloud, Virtualizzazione e Cyber Security."
  },
  {
    period: "03/2024 - 03/2025",
    role: "Corso di Programmazione Python e AI",
    institution: "Istituto Volta",
    logo: "/logos/istituto-volta.png",
    description: "Percorso formativo specializzato sulla sintassi Python, OOP e Strutture Dati. Fondamenti Machine Learning e Deep Learning."
  },
  {
    period: "2018 - 2023",
    role: "Diploma di Maturità in Informatica",
    institution: "ITIS Stanislao Cannizzaro, Rho"
  }
];
---

<section id="formazione" class="py-20 bg-slate-100 dark:bg-slate-800 transition-colors duration-300">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl transition-colors">Formazione</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 transition-colors">Il mio percorso di studi e le specializzazioni tecniche.</p>
    </div>
    
    <div class="relative border-l border-slate-300 dark:border-slate-700 ml-3 md:ml-6 transition-colors">
      <div class="space-y-12">
        {educationData.map((item, index) => (
          <div class="relative pl-8 md:pl-12">
            <!-- Timeline node -->
            <div class="absolute left-[-5px] top-10 h-2.5 w-2.5 rounded-full bg-blue-600 dark:bg-blue-500 ring-4 ring-slate-100 dark:ring-slate-800 transition-colors z-10"></div>
            
            <!-- Card -->
            <div class="bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 shadow-sm rounded-2xl p-6 md:p-8 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-4">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white transition-colors">{item.role}</h3>
                <time class="text-sm font-medium text-blue-600 dark:text-blue-400 mt-2 sm:mt-0 px-3 py-1 bg-blue-100 dark:bg-blue-900/30 rounded-full inline-block w-max transition-colors shrink-0">
                  {item.period}
                </time>
              </div>
              
              <div class="flex items-center gap-3 text-base font-medium text-slate-700 dark:text-slate-300 mb-4 transition-colors">
                {item.logo && (
                  <img src={item.logo} alt={`Logo ${item.institution}`} class="h-6 w-auto object-contain" />
                )}
                <span>{item.institution}</span>
              </div>
              
              {item.description && (
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed transition-colors">
                  {item.description}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

