---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  slug: string;
  techIcons: string[];
}

const { title, description, slug, techIcons } = Astro.props;
---

<div class="flex-none w-80 md:w-96 snap-start">
  <div class="flex flex-col h-full rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow p-6">
    <div class="flex-1">
      <h3 class="text-xl font-semibold text-slate-900 mb-3">{title}</h3>
      <p class="text-slate-600 mb-6 text-sm leading-relaxed">{description}</p>
    </div>
    
    <div class="mt-auto">
      <div class="flex flex-wrap gap-2 mb-6">
        {techIcons.map((icon) => (
          <div class="p-2 bg-slate-50 rounded-md ring-1 ring-inset ring-slate-200" title={icon}>
            <Icon name={icon} class="w-6 h-6 text-slate-700" />
          </div>
        ))}
      </div>
      
      <a 
        href={`/progetti/${slug}`} 
        class="inline-flex w-full items-center justify-center rounded-lg bg-slate-50 px-4 py-2.5 text-sm font-semibold text-blue-700 hover:bg-blue-50 hover:text-blue-800 ring-1 ring-inset ring-slate-200 hover:ring-blue-200 transition-colors"
      >
        Dettagli Progetto
        <Icon name="ph:arrow-right-bold" class="ml-2 w-4 h-4" />
      </a>
    </div>
  </div>
</div>

