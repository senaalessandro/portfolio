---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  slug: string;
  status: "Completato" | "In corso" | "Sospeso";
  techs: { icon: string; label?: string }[];
}

const { title, description, slug, status, techs } = Astro.props;

const statusClasses = {
  "Completato": "bg-green-100 text-green-800 border-green-200 dark:bg-green-900/30 dark:text-green-400 dark:border-green-800",
  "In corso": "bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-900/30 dark:text-amber-400 dark:border-amber-800",
  "Sospeso": "bg-red-100 text-red-800 border-red-200 dark:bg-red-900/30 dark:text-red-400 dark:border-red-800"
};

const dotClasses = {
  "Completato": "bg-green-500",
  "In corso": "bg-amber-500",
  "Sospeso": "bg-red-500"
};
---

<div class="flex-none w-80 md:w-96 snap-start">
  <div class="flex flex-col h-full rounded-2xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 dark:hover:border-blue-400 p-6">
    <div class="flex-1">
      <div class="flex items-start justify-between mb-3 gap-2">
        <h3 class="text-xl font-semibold text-slate-900 dark:text-white transition-colors">{title}</h3>
        <span class={`flex-shrink-0 inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-semibold border ${statusClasses[status]} transition-colors`}>
          <span class={`w-1.5 h-1.5 rounded-full ${dotClasses[status]}`}></span>
          {status}
        </span>
      </div>
      <p class="text-slate-600 dark:text-slate-300 mb-6 text-sm leading-relaxed transition-colors">{description}</p>
    </div>
    
    <div class="mt-auto">
      <div class="flex flex-wrap gap-2 mb-6">
        {techs.map((tech) => (
          <div class="flex items-center gap-2 p-1.5 rounded-md bg-slate-50 border border-slate-200 dark:bg-slate-700/50 dark:border-slate-600 transition-colors" title={tech.label || "Tecnologia"}>
            <img src={tech.icon} class="h-5 w-auto object-contain" alt="" />
            {tech.label && <span class="text-xs font-medium text-slate-700 dark:text-slate-300 pr-1">{tech.label}</span>}
          </div>
        ))}
      </div>
      
      <a 
        href={`/progetti/${slug}`} 
        class="inline-flex w-full items-center justify-center rounded-lg bg-white dark:bg-slate-700 px-4 py-2.5 text-sm font-semibold text-blue-700 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-slate-600 hover:text-blue-800 dark:hover:text-blue-300 ring-1 ring-inset ring-slate-200 dark:ring-slate-600 hover:ring-blue-200 dark:hover:ring-slate-500 transition-colors"
      >
        Dettagli Progetto
        <Icon name="ph:arrow-right-bold" class="ml-2 w-4 h-4" />
      </a>
    </div>
  </div>
</div>

