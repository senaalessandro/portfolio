---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import { Icon } from 'astro-icon/components';

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title}  | Alessandro Sena`}>
  <Header />
  
  <main class="pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- PULSANTE "TORNA AI PROGETTI" -->
      <div class="mb-8">
        <a href="/#progetti" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-slate-600 dark:text-slate-300 transition-all duration-200 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100/80 dark:hover:bg-slate-800/80">
          <Icon name="ph:arrow-left-bold" class="h-4 w-4" />
          Torna ai progetti
        </a>
      </div>
      
      <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden transition-colors duration-300">
        <div class="p-8 md:p-12">
          
          <!-- STATUS BADGE E TITOLO -->
          <div class="flex items-center flex-wrap gap-4 mb-4">
            <h1 class="text-3xl md:text-4xl font-bold m-0 leading-tight text-slate-900 dark:text-white transition-colors">{frontmatter.title}</h1>
            
            {frontmatter.status && (
              <span class={`inline-flex px-3 py-1 mt-1 text-xs font-semibold rounded-full border ${
                frontmatter.status === 'In corso' ? 'bg-amber-50 text-amber-600 border-amber-200 dark:bg-amber-900/30 dark:text-amber-400 dark:border-amber-800' : 
                frontmatter.status === 'Completato' ? 'bg-emerald-50 text-emerald-600 border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-400 dark:border-emerald-800' :
                frontmatter.status === 'Sospeso' ? 'bg-red-100 text-red-800 border-red-200 dark:bg-red-900/30 dark:text-red-400 dark:border-red-800' :
                'bg-slate-50 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700'
              }`}>
                {frontmatter.status}
              </span>
            )}
          </div>
          
          <!-- TECHS -->
          {frontmatter.techs && frontmatter.techs.length > 0 && (
            <div class="flex flex-wrap items-center gap-2 mb-8">
              {frontmatter.techs.map((tech: any) => {
                const iconPath = typeof tech === 'string' ? tech : tech.icon;
                const altText = typeof tech === 'string' ? "Tech logo" : (tech.label || "Tech logo");
                return (
                  <div class="p-1.5 rounded-lg bg-gray-50 border border-gray-200 dark:bg-slate-700/50 dark:border-slate-600 flex items-center justify-center transition-colors" title={altText}>
                    <img src={iconPath} alt={altText} class="w-6 h-6 object-contain" />
                  </div>
                );
              })}
            </div>
          )}
          
          <!-- CONTENUTO MARKDOWN -->
          <div class="prose prose-slate dark:prose-invert max-w-none prose-lg prose-headings:transition-colors prose-p:transition-colors prose-h1:hidden prose-h2:border-b prose-h2:border-gray-200 dark:prose-h2:border-gray-700 prose-h2:pb-2 prose-h2:mt-10 mt-8">
            <slot />
          </div>
          
        </div>
      </div>
    </div>
  </main>
</Layout>

